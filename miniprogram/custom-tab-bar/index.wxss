.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface, #ffffff);
  border-top: 1rpx solid var(--line, #e8eaed);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-2, #6b7280);
  transition: color 0.15s;
}

.tab.on .tab-text {
  color: var(--brand, #1f6feb);
  font-weight: 500;
}

.tab-bar {
  width: 0;
  height: 6rpx;
  border-radius: 3rpx;
  background: transparent;
  transition: width 0.18s;
}

.tab.on .tab-bar {
  width: 40rpx;
  background: var(--brand, #1f6feb);
}
