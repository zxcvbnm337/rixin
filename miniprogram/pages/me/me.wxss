.sum-row {
  display: flex;
}

.sum-cell {
  flex: 1;
  min-width: 0;
}

.sum-num {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

.sum-lab {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.status {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 8rpx 0;
}

.status-val {
  color: var(--text-3);
  font-size: 25rpx;
}

.set-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.set-lab {
  font-size: 28rpx;
}

.seg-mini {
  display: flex;
  background: var(--surface-2);
  border-radius: 14rpx;
  padding: 4rpx;
  flex: none;
}

.seg-mini-item {
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 25rpx;
  color: var(--text-2);
  border-radius: 12rpx;
}

.seg-mini-item.on {
  background: var(--surface);
  color: var(--text);
  font-weight: 500;
}

/* 自绘开关：小程序没有原生 switch 的配色控制，自绘更统一 */
.switch {
  width: 92rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--surface-2);
  flex: none;
  position: relative;
  transition: background 0.18s;
}

.switch.on {
  background: var(--brand);
}

.knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.18s;
}

.switch.on .knob {
  transform: translateX(40rpx);
}

.act-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  font-size: 28rpx;
}

.act-row.danger {
  color: var(--danger);
}

.act-tip {
  font-size: 24rpx;
  color: var(--text-3);
}

.act-tip.off {
  opacity: 0.5;
}

.privacy {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  padding: 10rpx 8rpx 0;
}
