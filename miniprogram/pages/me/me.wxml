<view class="page-wrap">

  <!-- 数据概览 -->
  <view class="card">
    <view class="card-title">我的记录</view>
    <view class="sum-row">
      <view class="sum-cell">
        <view class="sum-num">{{ov.records}}</view>
        <view class="sum-lab">总条数</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num">{{totalText}}</view>
        <view class="sum-lab">累计投入</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num">{{ov.days}}</view>
        <view class="sum-lab">记录天数</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num">{{ov.streak}}</view>
        <view class="sum-lab">连续天数</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="status">
      <view class="grow">存储方式</view>
      <view class="status-val">
        {{cloudReady ? '本机 + 云端' : '仅本机'}}
      </view>
    </view>
    <view class="status" wx:if="{{pending > 0}}">
      <view class="grow">待同步</view>
      <view class="status-val">{{pending}} 条（联网后自动补传）</view>
    </view>
  </view>

  <!-- 偏好设置 -->
  <view class="card">
    <view class="card-title">偏好</view>

    <view class="set-row">
      <view class="grow">
        <view class="set-lab">一周从哪天开始</view>
        <view class="hint">影响账本与周复盘的统计口径</view>
      </view>
      <view class="seg-mini">
        <view
          class="seg-mini-item {{weekStartsOn === item.v ? 'on' : ''}}"
          wx:for="{{weekOptions}}"
          wx:key="v"
          data-v="{{item.v}}"
          bindtap="pickWeekStart"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="set-row" bindtap="toggleAI">
      <view class="grow">
        <view class="set-lab">AI 智能解析</view>
        <view class="hint">开启后，一句话录入可自动识别分类与时长（待类目审核开放）</view>
      </view>
      <view class="switch {{aiEnabled ? 'on' : ''}}">
        <view class="knob"></view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <view class="card-title">数据</view>

    <view class="act-row" bindtap="onUndo">
      <view class="grow">撤销上一次删除</view>
      <view class="act-tip {{canUndo ? '' : 'off'}}">{{canUndo ? '可撤销' : '无记录'}}</view>
    </view>
    <view class="divider"></view>

    <view class="act-row" bindtap="exportData">
      <view class="grow">导出数据</view>
      <view class="act-tip">复制为 JSON</view>
    </view>
    <view class="divider"></view>

    <view class="act-row" bindtap="importData">
      <view class="grow">导入数据</view>
      <view class="act-tip">从剪贴板恢复</view>
    </view>
    <view class="divider"></view>

    <view class="act-row danger" bindtap="clearData">
      <view class="grow">清空全部记录</view>
      <view class="act-tip">不可恢复</view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="act-row" bindtap="about">
      <view class="grow">关于时间账本</view>
      <view class="act-tip">v{{version}}</view>
    </view>
  </view>

  <view class="privacy">
    数据默认只保存在这台手机上，不上传、不需要登录。你可以随时导出带走。
  </view>

</view>
