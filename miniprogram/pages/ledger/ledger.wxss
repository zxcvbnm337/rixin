.seg {
  display: flex;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 27rpx;
  color: var(--text-2);
  border-radius: 16rpx;
}

.seg-item.on {
  background: var(--surface);
  color: var(--text);
  font-weight: 500;
}

.sum-row {
  display: flex;
}

.sum-cell {
  flex: 1;
}

.sum-num {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

.sum-lab {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* ---------- 柱状图 ---------- */

.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: 10rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.bar-val {
  font-size: 20rpx;
  color: var(--text-3);
  height: 30rpx;
  white-space: nowrap;
}

.bar-track {
  height: 260rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 40rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
}

.bar.today {
  background: var(--brand);
}

.bar-lab {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

/* ---------- 分类分布 ---------- */

.kind {
  margin-bottom: 26rpx;
}

.kind:last-child {
  margin-bottom: 0;
}

.kind-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.kind-lab {
  font-size: 27rpx;
}

.kind-pct {
  font-size: 25rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  margin-left: 12rpx;
}

.kind-dur {
  font-size: 25rpx;
  color: var(--text-3);
  width: 130rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.kind-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-2);
  overflow: hidden;
}

.kind-fill {
  height: 100%;
  border-radius: 6rpx;
  min-width: 6rpx;
}

/* ---------- 明细 ---------- */

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.chips {
  display: flex;
  gap: 14rpx;
  padding-bottom: 8rpx;
}

.chip {
  flex: none;
  padding: 0 26rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: 25rpx;
}

.chip.on {
  background: var(--brand);
  color: #ffffff;
}

.day {
  padding-top: 26rpx;
}

.day-head {
  display: flex;
  align-items: baseline;
  padding-bottom: 10rpx;
}

.day-date {
  font-size: 27rpx;
  color: var(--text-2);
}

.day-sum {
  font-size: 23rpx;
  color: var(--text-3);
}

.rec {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rec:last-child {
  border-bottom: none;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex: none;
}

.rec-title {
  font-size: 28rpx;
  line-height: 1.4;
}

.rec-sub {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.rec-dur {
  font-size: 27rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  margin-left: 16rpx;
}

.empty {
  padding: 34rpx 0 20rpx;
  text-align: center;
}

.empty-t {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.mini-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 0 36rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 27rpx;
}
