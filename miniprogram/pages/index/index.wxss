.hero {
  padding: 20rpx 8rpx 36rpx;
}

.hero-date {
  font-size: 26rpx;
  color: var(--text-2);
}

.hero-dur {
  font-size: 76rpx;
  line-height: 1.15;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin: 8rpx 0 6rpx;
}

.hero-sub {
  font-size: 25rpx;
  color: var(--text-3);
}

.nudge {
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 25rpx;
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.ipt {
  width: 100%;
  height: 88rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  font-size: 29rpx;
  box-sizing: border-box;
}

.ipt-ph {
  color: var(--text-3);
  font-size: 28rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 26rpx 0 14rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
}

.chip {
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: 27rpx;
}

.chip.on {
  background: var(--brand);
  color: #ffffff;
}

.chip-ipt {
  width: 160rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: var(--surface-2);
  font-size: 27rpx;
  box-sizing: border-box;
}

.add {
  width: 100%;
  margin-top: 34rpx;
}

.rec {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rec:last-child {
  border-bottom: none;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex: none;
}

.rec-title {
  font-size: 29rpx;
  line-height: 1.4;
}

.rec-sub {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.rec-dur {
  font-size: 27rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  margin-left: 16rpx;
}

.rec-del {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 12rpx 0 12rpx 26rpx;
  margin-left: 6rpx;
}

.empty {
  padding: 30rpx 0 14rpx;
  text-align: center;
}

.empty-t {
  font-size: 29rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.foot {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 10rpx 8rpx 0;
}

.foot-link {
  font-size: 27rpx;
  color: var(--brand);
  padding: 16rpx 0;
}
